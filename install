#!/bin/bash
# One-shot install: clone payton.macromancy and wire Hyprland.
set -euo pipefail

PLUGIN_URL="https://github.com/paytbidd/omarchy-macromancy.git"
PLUGIN_ID="payton.macromancy"
PLUGINS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"

if [[ ! -d $PLUGINS_DIR/$PLUGIN_ID/.git ]]; then
  omarchy plugin add "$PLUGIN_URL" --yes --enable
fi

exec "$PLUGINS_DIR/$PLUGIN_ID/scripts/omarchy-macromancy" apply
